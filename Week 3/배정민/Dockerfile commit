# 베이스 이미지 설정
FROM node:20.15.1

# 작업 디렉토리 설정
WORKDIR /apps/mbti

# 환경 변수 설정
ENV PORT=3001
ENV DB_HOST=localhost
ENV DB_PORT=3306
ENV DB_NAME=db_mbti
ENV DB_USERNAME=user_mbti
ENV DB_PASSWORD=pw_mbti

# package.json과 package-lock.json 파일만 복사
COPY package*.json ./

# 의존성 설치
RUN npm install

# 소스 코드 복사
COPY . .

# 애플리케이션 실행
EXPOSE 3001
CMD ["npm", "run", "start"]
